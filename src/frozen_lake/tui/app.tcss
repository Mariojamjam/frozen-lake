Screen {
    layout: vertical;
}

#main {
    height: auto;
    min-height: 12;
}

#lake {
    width: auto;
    min-width: 30;
    height: auto;
    padding: 1 2;
    border: round $primary;
}

#status {
    width: 1fr;
    min-width: 40;
    height: auto;
    padding: 1 2;
    border: round $secondary;
}

#log {
    height: 1fr;
    min-height: 5;
    border: round $secondary;
}
