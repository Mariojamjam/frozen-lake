Screen {
    layout: vertical;
    background: $background;
}

#main {
    height: 1fr;
    min-height: 14;
}

#lake-panel {
    width: 1fr;
    height: 100%;
    border: heavy $primary;
    border-title-color: $accent;
    border-title-style: bold;
    border-subtitle-color: $text-muted;
}

#lake {
    width: 1fr;
    height: 1fr;
}

#side {
    width: 46;
    height: 100%;
}

#status {
    height: 1fr;
    padding: 0 2;
    border: round $secondary;
    border-title-color: $secondary;
    background: $surface;
}

#legend {
    height: auto;
    padding: 0 1;
    border: round $panel-lighten-2;
    border-title-color: $text-muted;
    background: $surface;
}

#bottom {
    height: 8;
}

#log {
    width: 1fr;
    height: 100%;
    overflow-x: hidden;
    border: round $panel-lighten-2;
    border-title-color: $text-muted;
    background: $surface;
}

#estimates {
    width: 46;
    height: 100%;
    overflow-x: hidden;
    border: round $secondary;
    border-title-color: $secondary;
    background: $surface;
}

SettingsScreen {
    align: center middle;
    background: $background 60%;
}

#settings {
    width: 64;
    height: auto;
    padding: 1 2;
    border: heavy $primary;
    border-title-color: $accent;
    border-title-style: bold;
    background: $surface;
}

#settings #title {
    color: $text-muted;
    margin-bottom: 1;
}

#settings .row {
    height: 3;
}

#settings Label {
    width: 30;
    padding: 1 0;
}

#settings Input {
    width: 1fr;
}

#settings #problems {
    height: auto;
    margin: 1 0;
}

#settings .buttons {
    height: auto;
    align: right middle;
}

#settings Button {
    margin-left: 2;
}
