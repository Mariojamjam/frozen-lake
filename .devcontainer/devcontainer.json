{
  "name": "frozen-lake",
  "build": { "dockerfile": "Dockerfile" },
  "remoteUser": "vscode",
  "containerEnv": {
    "UV_PROJECT_ENVIRONMENT": "/home/vscode/.venvs/frozen-lake"
  },
  "remoteEnv": {
    "PATH": "/home/vscode/.venvs/frozen-lake/bin:${containerEnv:PATH}"
  },
  "postCreateCommand": "uv sync --locked",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"],
      "settings": {
        "python.defaultInterpreterPath": "/home/vscode/.venvs/frozen-lake/bin/python",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
